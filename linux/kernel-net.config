# Kernel options for the second Ethernet port and the bridge over both ports
# (linux/net/interfaces, linux/pl/zynq-mini-pl.dtso):
#   the PL-side PHY sits behind Xilinx's GMII-to-RGMII converter, and br0 (with
#   STP) joins eth0 and eth1 so a cable in either port reaches the board.
CONFIG_XILINX_GMII2RGMII=y
CONFIG_BRIDGE=y
CONFIG_STP=y
CONFIG_LLC=y
