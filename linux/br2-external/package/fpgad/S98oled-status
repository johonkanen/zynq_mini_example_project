#!/bin/sh
#
# oled-status - IP address + die temperature on OLED rows 6/7 (an fpgad client,
# starts after S96fpgad). Interval: /etc/default/oled-status (INTERVAL=...).
#
DAEMON=/usr/bin/oled-status
PIDFILE=/var/run/oled-status.pid
INTERVAL=2
[ -r /etc/default/oled-status ] && . /etc/default/oled-status

case "$1" in
	start)
		printf "Starting oled-status: "
		pid=$(cat "$PIDFILE" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			echo "already running"; exit 0
		fi
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- "$INTERVAL" \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping oled-status: "
		# a shell script: stop it by its pid (start-stop-daemon -x would look for "sh")
		pid=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		i=0
		while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 30 ]; do
			sleep 0.1; i=$((i + 1))
		done
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid"; echo "killed"
		else
			echo "OK"
		fi
		rm -f "$PIDFILE"
		;;
	restart|reload)
		"$0" stop; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
