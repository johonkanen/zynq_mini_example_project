#!/bin/sh
#
# fpgad - owns the FPGA: loads the good design (/data/pl/good) at start, arms the
# hardware watchdog, serves /var/run/fpgad.sock (doc/network_update.md)
# Logs go to syslog (/var/log/messages). Extra args: /etc/default/fpgad (ARGS=...).
#
DAEMON=/usr/sbin/fpgad
PIDFILE=/var/run/fpgad.pid
ARGS=""
[ -r /etc/default/fpgad ] && . /etc/default/fpgad

case "$1" in
	start)
		printf "Starting fpgad: "
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping fpgad: "
		pid=$(cat "$PIDFILE" 2>/dev/null)
		start-stop-daemon -K -q -p "$PIDFILE"
		# wait until it has really exited before returning (it holds a socket/port)
		i=0
		while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do
			sleep 0.1; i=$((i + 1))
		done
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid"; echo "killed"
		else
			echo "OK"
		fi
		rm -f "$PIDFILE"
		;;
	restart|reload)
		"$0" stop; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
