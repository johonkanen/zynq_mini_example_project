#!/bin/sh
#
# fpga-web - FPGA web UI on port 80 (talks to fpgad, never to the hardware)
# Logs go to syslog (/var/log/messages). Extra args: /etc/default/fpga-web (ARGS=...).
#
DAEMON=/usr/bin/fpga-web
PIDFILE=/var/run/fpga-web.pid
ARGS=""
[ -r /etc/default/fpga-web ] && . /etc/default/fpga-web

case "$1" in
	start)
		printf "Starting fpga-web: "
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping fpga-web: "
		pid=$(cat "$PIDFILE" 2>/dev/null)
		start-stop-daemon -K -q -p "$PIDFILE"
		# wait until it has really exited before returning (it holds a socket/port)
		i=0
		while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do
			sleep 0.1; i=$((i + 1))
		done
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid"; echo "killed"
		else
			echo "OK"
		fi
		rm -f "$PIDFILE"
		;;
	restart|reload)
		"$0" stop; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
