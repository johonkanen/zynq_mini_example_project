#!/bin/sh
#
# fpga-webstream: live PL data web page on port 80 (after S95fpga loads the PL).
# Logs go to syslog (/var/log/messages).
#
DAEMON=/usr/bin/fpga-webstream
PIDFILE=/var/run/fpga-webstream.pid
ARGS=""
[ -r /etc/default/fpga-webstream ] && . /etc/default/fpga-webstream

case "$1" in
	start)
		printf "Starting fpga-webstream: "
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping fpga-webstream: "
		pid=$(cat "$PIDFILE" 2>/dev/null)
		start-stop-daemon -K -q -p "$PIDFILE"
		# wait until it has really exited: it holds port 80 and reads the PL
		# over GP0 until then (S95fpga must not reprogram the PL under it)
		i=0
		while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do
			sleep 0.1; i=$((i + 1))
		done
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid"; echo "killed"
		else
			echo "OK"
		fi
		rm -f "$PIDFILE"
		;;
	restart|reload)
		"$0" stop; sleep 1; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
