# Kernel options for RAUC bundles (doc/network_update.md): a bundle is a
# squashfs image, mounted through a loop device and checked with dm-verity.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# dm-verity hashes with SHA-256 ("verity: Cannot initialize hash function" without it)
CONFIG_CRYPTO_SHA256=y
